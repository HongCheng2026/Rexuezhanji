page {
  background: #050b13;
  color: #f4f8ff;
  font-family: "Microsoft YaHei", Arial, sans-serif;
  min-height: 100vh;
}

view,
text,
button,
image,
canvas {
  box-sizing: border-box;
}

button {
  background: transparent;
  border: 0;
  border-radius: 0;
  color: inherit;
  font: inherit;
  line-height: inherit;
  margin: 0;
  padding: 0;
}

button::after {
  border: 0;
}

.hidden {
  display: none !important;
}

