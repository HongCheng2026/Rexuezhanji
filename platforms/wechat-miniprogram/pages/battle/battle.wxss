.battle-page {
  background: #050b13;
  height: 100vh;
  overflow: hidden;
  position: relative;
  width: 100vw;
}

.battle-canvas {
  height: 100vh;
  left: 0;
  position: absolute;
  top: 0;
  width: 100vw;
}

.hud {
  display: grid;
  gap: 10rpx;
  grid-template-columns: repeat(4, 1fr);
  left: 20rpx;
  position: absolute;
  right: 20rpx;
  top: calc(env(safe-area-inset-top) + 18rpx);
  z-index: 2;
}

.hud view {
  background: rgba(5, 21, 39, 0.78);
  border: 1rpx solid rgba(73, 198, 255, 0.48);
  color: #aedaef;
  display: grid;
  gap: 4rpx;
  min-height: 64rpx;
  padding: 8rpx;
  text-align: center;
}

.value {
  color: #fff;
  font-size: 25rpx;
  font-weight: 900;
}

.back-home {
  background: rgba(5, 21, 39, 0.78);
  border: 1rpx solid rgba(73, 198, 255, 0.55);
  color: #d9f5ff;
  font-size: 24rpx;
  left: 20rpx;
  min-height: 52rpx;
  padding: 0 20rpx;
  position: absolute;
  top: calc(env(safe-area-inset-top) + 100rpx);
  z-index: 3;
}

.overlay {
  align-items: center;
  background: rgba(1, 6, 12, 0.64);
  display: flex;
  height: 100vh;
  justify-content: center;
  left: 0;
  padding: 28rpx;
  position: absolute;
  top: 0;
  width: 100vw;
  z-index: 4;
}

.panel {
  background: linear-gradient(145deg, rgba(8, 31, 54, 0.96), rgba(4, 12, 22, 0.98));
  border: 2rpx solid rgba(73, 198, 255, 0.68);
  box-shadow: 0 28rpx 90rpx rgba(0, 0, 0, 0.55), inset 0 0 32rpx rgba(73, 198, 255, 0.12);
  max-width: 900rpx;
  padding: 30rpx;
  width: 100%;
}

.panel-kicker {
  color: #ffd86b;
  display: block;
  font-size: 22rpx;
  font-weight: 900;
}

.panel-title {
  display: block;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1.1;
  margin-top: 12rpx;
}

.panel-body {
  color: #cfe5f5;
  display: block;
  font-size: 26rpx;
  line-height: 1.65;
  margin-top: 16rpx;
}

.level-grid {
  display: grid;
  gap: 14rpx;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 24rpx;
}

.level-card {
  background: rgba(8, 31, 54, 0.88);
  border: 2rpx solid rgba(73, 198, 255, 0.44);
  display: grid;
  gap: 8rpx;
  min-height: 160rpx;
  padding: 16rpx;
  text-align: left;
}

.level-card.active {
  border-color: #ffd86b;
  box-shadow: inset 0 0 24rpx rgba(255, 216, 107, 0.18);
}

.level-card.locked {
  opacity: 0.48;
}

.level-code {
  font-size: 24rpx;
  font-weight: 900;
}

.level-desc,
.level-state {
  color: #bcd9ed;
  font-size: 19rpx;
  line-height: 1.35;
}

.primary,
.secondary {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
  margin-top: 24rpx;
  min-height: 76rpx;
  text-align: center;
  width: 100%;
}

.primary {
  background: linear-gradient(180deg, rgba(255, 218, 96, 0.96), rgba(171, 92, 8, 0.96));
  border: 3rpx solid rgba(255, 236, 153, 0.94);
  color: #fff8d8;
}

.secondary {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(160, 226, 255, 0.45);
  color: #d9f5ff;
}

@media (max-width: 700px) {
  .level-grid {
    grid-template-columns: 1fr;
  }
}
