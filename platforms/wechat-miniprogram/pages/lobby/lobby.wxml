<view class="lobby-page">
  <image class="main-bg" src="/assets/images/main-ui-portrait-lite.jpg" mode="aspectFill" />
  <view class="screen-tint"></view>

  <view class="top-profile">
    <button class="avatar-button" bindtap="openFeature" data-key="profile">
      <image class="avatar" src="{{profile.player.avatar}}" mode="aspectFill" />
    </button>
    <view class="profile-copy">
      <text class="pilot-name">{{profile.player.name}}</text>
      <text class="pilot-level">Lv.{{profile.player.level}}</text>
      <view class="exp-row">
        <text>EXP</text>
        <view class="exp-track">
          <view class="exp-fill" style="width: {{expPercent}}%;"></view>
        </view>
      </view>
      <text class="exp-text">{{profile.player.exp}} / {{profile.player.expMax}}</text>
    </view>
    <button class="badge-button" bindtap="openFeature" data-key="profile">
      <text>{{profile.player.badge}}</text>
    </button>
  </view>

  <view class="top-resources">
    <button class="resource-pill" bindtap="openFeature" data-key="energy">
      <text class="res-icon energy">⚡</text>
      <text class="res-value">{{resources.energy}}/{{resources.energyMax}}</text>
      <text class="res-plus">+</text>
    </button>
    <button class="resource-pill" bindtap="openFeature" data-key="gold">
      <text class="res-icon gold">₿</text>
      <text class="res-value">{{resources.gold}}</text>
      <text class="res-plus">+</text>
    </button>
    <button class="resource-pill" bindtap="openFeature" data-key="diamond">
      <text class="res-icon diamond">◆</text>
      <text class="res-value">{{resources.diamond}}</text>
      <text class="res-plus">+</text>
    </button>
  </view>

  <view class="quick-row">
    <button bindtap="openFeature" data-key="mail">✉</button>
    <button bindtap="openFeature" data-key="signin">▣</button>
    <button bindtap="openFeature" data-key="friend">♟</button>
    <button bindtap="openFeature" data-key="setting">⚙</button>
  </view>

  <button class="assistant-hotspot" bindtap="greetAssistant" aria-label="助理问候"></button>
  <image wx:if="{{profile.assistant.image}}" class="assistant-image" src="{{profile.assistant.image}}" mode="aspectFit" bindtap="greetAssistant" />

  <button class="side-card first-topup" bindtap="openFeature" data-key="firstTopup">
    <text class="side-title">首充礼包</text>
    <text class="side-sub">FIRST TOP-UP</text>
  </button>
  <button class="side-card pass-card" bindtap="openFeature" data-key="monthlyPass">
    <text class="side-title">月卡特权</text>
    <text class="side-sub">MONTHLY PASS</text>
  </button>
  <button class="side-card shop-card" bindtap="openFeature" data-key="shop">
    <text class="side-title">商店</text>
    <text class="side-sub">SHOP</text>
  </button>
  <button class="side-card upgrade-card" bindtap="openFeature" data-key="upgrade">
    <text class="side-title">升级</text>
    <text class="side-sub">UPGRADE</text>
  </button>

  <button class="battle-button" bindtap="startBattle">
    <text class="arrow">≪</text>
    <view>
      <text class="battle-title">开始战斗</text>
      <text class="battle-sub">START BATTLE</text>
    </view>
    <text class="arrow">≫</text>
  </button>

  <view class="bottom-grid">
    <block wx:for="{{menuItems}}" wx:key="key">
      <button class="menu-tile {{item.notice ? 'notice' : ''}}" bindtap="openFeature" data-key="{{item.key}}">
        <text class="menu-icon">{{item.icon}}</text>
        <text class="menu-title">{{item.title}}</text>
        <text class="menu-sub">{{item.sub}}</text>
      </button>
    </block>
  </view>

  <button class="chat-bar" bindtap="openFeature" data-key="chat">[世界] 王牌飞行员：欢迎加入飞行战队！</button>
</view>
