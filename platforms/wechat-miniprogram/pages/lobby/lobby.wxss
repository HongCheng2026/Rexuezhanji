.lobby-page {
  background: #050b13;
  height: 100vh;
  overflow: hidden;
  position: relative;
  width: 100vw;
}

.main-bg,
.screen-tint {
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  width: 100%;
}

.screen-tint {
  background:
    linear-gradient(180deg, rgba(1, 7, 14, 0.26), rgba(1, 7, 14, 0.06) 42%, rgba(1, 7, 14, 0.18)),
    radial-gradient(circle at 50% 55%, rgba(8, 35, 65, 0.08), rgba(0, 0, 0, 0.24));
  pointer-events: none;
}

.top-profile {
  align-items: center;
  display: grid;
  gap: 12rpx;
  grid-template-columns: 104rpx 1fr 86rpx;
  left: 20rpx;
  position: absolute;
  right: 360rpx;
  top: calc(env(safe-area-inset-top) + 14rpx);
  z-index: 4;
}

.avatar-button {
  background: rgba(2, 14, 28, 0.72);
  border: 2rpx solid rgba(75, 205, 255, 0.88);
  box-shadow: 0 0 18rpx rgba(62, 190, 255, 0.55);
  height: 104rpx;
  overflow: hidden;
  width: 104rpx;
}

.avatar {
  display: block;
  height: 100%;
  width: 100%;
}

.profile-copy {
  min-width: 0;
}

.pilot-name {
  color: #ffffff;
  display: block;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.65);
  white-space: nowrap;
}

.pilot-level {
  color: #ffe36f;
  display: block;
  font-size: 24rpx;
  font-weight: 900;
  margin-top: 12rpx;
}

.exp-row {
  align-items: center;
  display: grid;
  gap: 8rpx;
  grid-template-columns: 48rpx 1fr;
  margin-top: 10rpx;
}

.exp-row text {
  color: #37d6ff;
  font-size: 18rpx;
  font-weight: 900;
}

.exp-track {
  background: rgba(2, 13, 28, 0.9);
  border: 1rpx solid rgba(105, 185, 255, 0.45);
  height: 12rpx;
  overflow: hidden;
}

.exp-fill {
  background: linear-gradient(90deg, #18bfff, #c7f8ff);
  height: 100%;
}

.exp-text {
  color: #f3fbff;
  display: block;
  font-size: 19rpx;
  font-weight: 800;
  margin-top: 4rpx;
  text-align: right;
}

.badge-button {
  align-items: center;
  background: radial-gradient(circle, rgba(255, 207, 74, 0.32), rgba(4, 19, 37, 0.78));
  border: 0;
  color: #ffe17b;
  display: flex;
  font-size: 34rpx;
  font-weight: 900;
  height: 78rpx;
  justify-content: center;
  text-shadow: 0 0 10rpx rgba(255, 206, 72, 0.78);
  width: 78rpx;
}

.top-resources {
  display: grid;
  gap: 10rpx;
  grid-template-columns: repeat(3, 1fr);
  position: absolute;
  right: 18rpx;
  top: calc(env(safe-area-inset-top) + 24rpx);
  width: 342rpx;
  z-index: 5;
}

.resource-pill {
  align-items: center;
  background: rgba(2, 17, 34, 0.9);
  border: 2rpx solid rgba(72, 194, 255, 0.72);
  box-shadow: inset 0 0 16rpx rgba(72, 194, 255, 0.14), 0 0 10rpx rgba(72, 194, 255, 0.24);
  display: grid;
  gap: 4rpx;
  grid-template-columns: 24rpx 1fr 18rpx;
  height: 40rpx;
  padding: 0 4rpx;
}

.res-icon {
  font-size: 18rpx;
  font-weight: 900;
}

.res-icon.energy {
  color: #38d8ff;
}

.res-icon.gold {
  color: #ffd15d;
}

.res-icon.diamond {
  color: #64d9ff;
}

.res-value {
  color: #fff;
  font-size: 16rpx;
  font-weight: 900;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.res-plus {
  color: #8edfff;
  font-size: 22rpx;
  font-weight: 900;
}

.quick-row {
  display: grid;
  gap: 8rpx;
  grid-template-columns: repeat(4, 1fr);
  position: absolute;
  right: 20rpx;
  top: calc(env(safe-area-inset-top) + 84rpx);
  width: 280rpx;
  z-index: 5;
}

.quick-row button {
  align-items: center;
  background: rgba(2, 17, 34, 0.88);
  border: 1rpx solid rgba(79, 198, 255, 0.55);
  color: #d9f5ff;
  display: flex;
  font-size: 30rpx;
  height: 52rpx;
  justify-content: center;
}

.assistant-hotspot {
  background: transparent;
  height: 520rpx;
  left: 180rpx;
  position: absolute;
  top: 520rpx;
  width: 390rpx;
  z-index: 3;
}

.assistant-image {
  height: 570rpx;
  left: 132rpx;
  position: absolute;
  top: 510rpx;
  width: 480rpx;
  z-index: 4;
}

.side-card {
  background: rgba(2, 17, 34, 0.12);
  border: 0;
  color: #fff;
  display: grid;
  padding: 0;
  position: absolute;
  text-align: left;
  z-index: 4;
}

.side-title {
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.75);
}

.side-sub {
  color: #c4e8ff;
  font-size: 17rpx;
  font-weight: 800;
  margin-top: 8rpx;
}

.first-topup,
.pass-card {
  height: 170rpx;
  left: 28rpx;
  padding: 30rpx 0 0 22rpx;
  width: 170rpx;
}

.first-topup {
  top: 196rpx;
}

.pass-card {
  top: 420rpx;
}

.shop-card,
.upgrade-card {
  height: 270rpx;
  padding: 34rpx 0 0 24rpx;
  right: 28rpx;
  width: 218rpx;
}

.shop-card {
  top: 202rpx;
}

.upgrade-card {
  top: 520rpx;
}

.battle-button {
  align-items: center;
  background: linear-gradient(180deg, rgba(255, 220, 99, 0.96), rgba(171, 95, 12, 0.96));
  border: 3rpx solid rgba(255, 238, 170, 0.96);
  box-shadow: inset 0 0 26rpx rgba(255, 255, 255, 0.22), 0 0 34rpx rgba(247, 174, 48, 0.5);
  color: #fff6cf;
  display: grid;
  grid-template-columns: 74rpx 1fr 74rpx;
  height: 108rpx;
  left: 132rpx;
  padding: 0 18rpx;
  position: absolute;
  right: 132rpx;
  text-align: center;
  text-shadow: 0 3rpx 8rpx rgba(74, 28, 0, 0.65);
  top: 1058rpx;
  z-index: 7;
}

.battle-title {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1;
}

.battle-sub {
  display: block;
  font-size: 20rpx;
  font-weight: 800;
  margin-top: 8rpx;
}

.arrow {
  font-size: 44rpx;
  font-weight: 900;
}

.bottom-grid {
  display: grid;
  gap: 18rpx;
  grid-template-columns: repeat(4, 1fr);
  left: 28rpx;
  position: absolute;
  right: 28rpx;
  top: 1210rpx;
  z-index: 5;
}

.menu-tile {
  align-items: center;
  aspect-ratio: 1;
  background: rgba(2, 17, 34, 0.26);
  border: 0;
  color: #eaf8ff;
  display: grid;
  justify-items: center;
  padding: 12rpx 6rpx;
  position: relative;
}

.menu-icon {
  color: #d7f1ff;
  font-size: 42rpx;
  line-height: 1;
}

.menu-title {
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1;
}

.menu-sub {
  color: #b9dcf6;
  font-size: 14rpx;
  font-weight: 800;
}

.notice::after {
  background: #ff3d42;
  border: 2rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 999rpx;
  content: "";
  height: 20rpx;
  position: absolute;
  right: 14rpx;
  top: 10rpx;
  width: 20rpx;
}

.chat-bar {
  background: rgba(2, 17, 34, 0.7);
  border: 1rpx solid rgba(110, 215, 255, 0.72);
  bottom: calc(env(safe-area-inset-bottom) + 18rpx);
  color: #d9f5ff;
  font-size: 21rpx;
  height: 54rpx;
  left: 24rpx;
  line-height: 54rpx;
  overflow: hidden;
  padding: 0 26rpx;
  position: absolute;
  right: 24rpx;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
  z-index: 5;
}

@media (max-height: 780px) {
  .battle-button {
    top: 950rpx;
  }

  .bottom-grid {
    top: 1090rpx;
  }

  .chat-bar {
    display: none;
  }
}
